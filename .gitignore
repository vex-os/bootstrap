## Ignore some files generated by VSCode
## except some things we might actually need
/.vscode/*
!/.vscode/c_cpp_properties.json

## Ignore Jinx cache
/.jinx-cache/

## Ignore Jinx build directories
/build-*/
/build/

## Ignore Jinx source directories
/host-sources/
/sources/

## Ignore stuff python runtime generates
__pycache__/
*.pyc

## Ignore output disk images
*.img
*.iso

## Ignore stuff that QEMU and other scripts
## might emit during building and testing
*.log
