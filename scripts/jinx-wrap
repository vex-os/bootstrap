#!/bin/sh
# Runs jinx from either the host PATH, or from the
# in-tree fallback script that sometimes gets updated
# Usage: scripts/jinx-wrap <jinx arguments>
# Everything but init runs inside the build directory (BUILD_DIR, default: build)
set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "${0}")" && pwd)"
source_dir="$(dirname -- "${script_dir}")"

build_dir="${BUILD_DIR:-build}"

case "${build_dir}" in
    /*) ;;
    *) build_dir="${source_dir}/${build_dir}" ;;
esac

if command -v jinx >/dev/null 2>&1; then
    jinx=jinx
else
    jinx="${script_dir}/jinx-fallback"
fi

if test "${1:-}" = "init"; then
    cd "${source_dir}"
    exec "${jinx}" "${@}"
fi

if ! test -f "${build_dir}/.jinx-parameters"; then
    echo "jinx-wrap: ${build_dir} is not initialised, run scripts/configure.sh first" >&2
    exit 1
fi

cd "${build_dir}"
exec "${jinx}" "${@}"
