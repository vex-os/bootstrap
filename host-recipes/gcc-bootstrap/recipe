#! /bin/sh

revision=1
from_host_source="gcc"
hostdeps="binutils gmp mpfr mpc"
imagedeps="build-essential"

target="${JINX_ARCH}-vex"

# This stage has no libc, so mlibc builds with it
configure() {
	"${source_dir}/configure" \
		--prefix="${prefix}" \
		--target="${target}" \
		--with-sysroot="${sysroot}" \
		--with-gmp="${prefix}" \
		--with-mpfr="${prefix}" \
		--with-mpc="${prefix}" \
		--without-headers \
		--enable-languages=c \
		--enable-initfini-array \
		--disable-threads \
		--disable-shared \
		--disable-multilib \
		--disable-nls \
		--disable-werror \
		--disable-libatomic \
		--disable-libgomp \
		--disable-libquadmath \
		--disable-libsanitizer \
		--disable-libssp \
		--disable-libvtv
}

build() {
	make -j${parallelism} all-gcc all-target-libgcc
}

package() {
	make install-gcc install-target-libgcc DESTDIR="${dest_dir}"
}
