#! /bin/sh

version=1.3.1
revision=1
tarball_url="https://ftp.gnu.org/gnu/mpc/mpc-${version}.tar.gz"
tarball_sha256="ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8"
hostdeps="gmp mpfr"
imagedeps="build-essential"

configure() {
	"${source_dir}/configure" \
		--prefix="${prefix}" \
		--with-gmp="${prefix}" \
		--with-mpfr="${prefix}" \
		--disable-shared \
		--enable-static
}

build() {
	make -j${parallelism}
}

package() {
	make install DESTDIR="${dest_dir}"
}
