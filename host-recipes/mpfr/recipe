#! /bin/sh

version=4.2.2
revision=1
tarball_url="https://ftp.gnu.org/gnu/mpfr/mpfr-${version}.tar.xz"
tarball_sha256="b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01"
hostdeps="gmp"
imagedeps="build-essential"

configure() {
	"${source_dir}/configure" \
		--prefix="${prefix}" \
		--with-gmp="${prefix}" \
		--disable-shared \
		--enable-static
}

build() {
	make -j${parallelism}
}

package() {
	make install DESTDIR="${dest_dir}"
}
